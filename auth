const $=id=>document.getElementById(id);const msg=(text,error=false)=>{const el=$('message');if(el){el.textContent=text;el.className='message '+(error?'error':'success');}};
async function post(url,body){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify(body)});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.error||'Request failed.');return d;}
const login=$('loginForm');if(login)login.addEventListener('submit',async e=>{e.preventDefault();const b=login.querySelector('button');b.disabled=true;b.textContent='Signing in…';try{const d=await post('/api/auth/login',{email:$('email').value,password:$('password').value});msg('Signed in successfully.');const next=new URLSearchParams(location.search).get('next');location.href=next&&next.startsWith('/')&&!next.startsWith('//')?next:(d.user.role==='admin'?'/admin.html':'/dashboard.html');}catch(err){msg(err.message,true);b.disabled=false;b.innerHTML='Sign In <span>→</span>';}});
const reg=$('registerForm');if(reg)reg.addEventListener('submit',async e=>{e.preventDefault();const b=reg.querySelector('button');b.disabled=true;b.textContent='Creating account…';try{await post('/api/auth/register',{name:$('name').value,email:$('email').value,password:$('password').value,phone:$('phone').value});msg('Account created. Opening your dashboard…');location.href='/dashboard.html';}catch(err){msg(err.message,true);b.disabled=false;b.innerHTML='Create Citizen Account <span>→</span>';}});
const admin=$('adminLoginForm');if(admin)admin.addEventListener('submit',async e=>{e.preventDefault();const b=admin.querySelector('button');b.disabled=true;b.textContent='Verifying…';try{const d=await post('/api/auth/login',{email:$('email').value,password:$('password').value});if(d.user.role!=='admin'){await fetch('/api/auth/logout',{method:'POST'});throw new Error('This account is a citizen account, not an administrator.');}location.href='/admin.html';}catch(err){msg(err.message,true);b.disabled=false;b.innerHTML='Authenticate <span>→</span>';}});
