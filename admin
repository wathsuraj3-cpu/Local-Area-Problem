const $=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',...opts});const d=await r.json().catch(()=>({success:false,error:'Invalid response'}));if(r.status===401||r.status===403){location.href='/admin-login.html';throw new Error('Administrator sign-in required.');}if(!r.ok||!d.success)throw new Error(d.error||'Request failed');return d;}
(async()=>{try{const [me,reports,stats]=await Promise.all([api('/api/auth/me'),api('/api/reports'),api('/api/stats')]);if(me.user?.role!=='admin'){location.href='/admin-login.html';return;}const s=stats.stats;$('total').textContent=s.total;$('pending').textContent=s.pending;$('progress').textContent=s.inProgress;$('resolved').textContent=s.resolved;render(reports.reports);$('statusFilter').addEventListener('change',()=>render(reports.reports));}catch(e){$('adminReports').innerHTML=`<div class="empty-state">${esc(e.message)}</div>`;}})();
function render(rows){const filter=$('statusFilter').value;const items=filter==='all'?rows:rows.filter(r=>r.status===filter);$('adminReports').innerHTML=items.length?items.map(r=>`<article class="report-item admin-item"><div class="report-main">${r.imageData?`<img class="evidence" src="${esc(r.imageData)}" alt="Evidence photo">`:''}<div class="report-meta"><span>${esc(r.category)}</span><span>${new Date(r.createdAt).toLocaleString()}</span></div><h3>${esc(r.title)}</h3><p>${esc(r.description)}</p><p class="location-line">📍 ${esc(r.location)}</p><small>${esc(r.citizenName)} · ${esc(r.citizenEmail)} · ${esc(r.id)}</small><label>Admin remarks<textarea id="remark-${esc(r.id)}" rows="2">${esc(r.adminRemarks||'')}</textarea></label><div class="admin-actions"><select id="status-${esc(r.id)}"><option ${r.status==='Pending'?'selected':''}>Pending</option><option ${r.status==='In Progress'?'selected':''}>In Progress</option><option ${r.status==='Resolved'?'selected':''}>Resolved</option><option ${r.status==='Rejected'?'selected':''}>Rejected</option></select><button class="btn primary" onclick="saveReport('${esc(r.id)}')">Save update</button></div></div><span class="status status-${r.status.toLowerCase().replaceAll(' ','-')}">${esc(r.status)}</span></article>`).join(''):'<div class="empty-state">No reports in this status.</div>';}
window.saveReport=async id=>{try{await api('/api/reports/'+encodeURIComponent(id),{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:$('status-'+id).value,adminRemarks:$('remark-'+id).value})});location.reload();}catch(e){alert(e.message);}};
document.querySelectorAll('[data-logout]').forEach(a=>a.addEventListener('click',async e=>{e.preventDefault();await fetch('/api/auth/logout',{method:'POST'});location.href='/';}));
